# This optional bot is deliberately separate from the FamTrack deployment.
# Create a different bot with BotFather before starting it manually.
FAMTRACK_CODEX_BOT_TOKEN=
# Required, fail-closed allowlist. The bot accepts only private chats whose
# chat id and sender id are both listed here.
FAMTRACK_CODEX_BOT_OWNER_IDS=
FAMTRACK_CODEX_BOT_WORKDIR=/absolute/path/to/workspace
FAMTRACK_CODEX_BOT_MODEL=
FAMTRACK_CODEX_BOT_CODEX_BIN=
FAMTRACK_CODEX_BOT_STATE_DIR=
