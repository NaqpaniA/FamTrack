@startuml
!pragma teoz true
!include ../_style_product_seq.puml

autonumber
title
FamTrack — POST /api/routines/complete (accumulator batch)
<size:12>One bounded batch atomically consumes physical units and awards XP</size>
end title
footer Contract: streak grows by N; all crossed milestones are summed; receipt prevents replay XP

actor "Family member" as actor
boundary "Household UI" as ui
boundary "HTTP API" as api
control "Routine domain" as routine
database "SQLite aggregate + receipts" as db

activate actor
actor -> ui : complete batch of N units
activate ui
ui -> api : POST /api/routines/complete\n{revision, mutationId, routineId, units:N}
activate api
api -> db : lookup receipt + read fresh aggregate
activate db
db --> api : exact duplicate | current state
deactivate db

alt exact duplicate mutationId
  api --> ui : authoritative state\nduplicate=true; no additional XP
else new command
  api -> routine : validate visibility/open task; clamp N\nselect fixed/round-robin assignee or free actor
  activate routine
  routine -> routine : nextStreak = streak + N\naward = baseXp × N + Σ bonus(streak+1..nextStreak)
  routine --> api : remaining units + rewardedUnits\nmember XP + one reward-log + one COMPLETED event
  deactivate routine
  api -> db : atomic task/member/reward/template/event/receipt/revision
  activate db
  db --> api : committed aggregate with fresh members
  deactivate db
  api -> api : resolve currentUser from fresh members\nbuild RBAC projection with fresh actor
  api --> ui : state + units/xp/creditedUserId\nduplicate=false; rebased flag
end

deactivate api
ui --> actor : +XP → confirmed assignee
deactivate ui
deactivate actor
@enduml
