@startuml
!pragma teoz true
!include ../_style_product_seq.puml

autonumber
title FamTrack — invite claims an existing placeholder member (no XP split)
footer Contract: claim updates the existing row; id, xp, level and streak survive linking

actor "Child (first Telegram login)" as child
boundary "Telegram Mini App" as app
boundary "HTTP API" as api
database "SQLite family aggregate" as db

activate child
child -> app : open invite deep link\nt.me/<bot>/<app>?startapp=<token>
activate app
app -> api : POST /api/family/invites/accept\n{token} + X-Telegram-Init-Data
activate api
api -> db : load invite by token + resolve telegram identity
activate db
db --> api : invite {familyId, role, targetUserId?} | none
deactivate db

alt invite missing / used / expired
  api --> app : 404 | 409 INVITE_USED | 410 INVITE_EXPIRED
else telegram account already in another family
  api --> app : 409 ACCOUNT_ALREADY_LINKED
else invite has targetUserId (claim flow)
  api -> db : verify target row: same family,\nactive, telegramId is empty
  activate db
  db --> api : placeholder member row
  deactivate db
  alt target already linked or missing
    api --> app : 409 CLAIM_TARGET_UNAVAILABLE
  else claim allowed
    api -> db : BEGIN; UPDATE existing user row:\ntelegram_id, username, names, avatarUrl;\nkeep id, xp, level, streak, role;\nmark invite used; revision +1
    activate db
    db --> api : COMMIT
    deactivate db
    api --> app : app-data envelope for claimed member
  end
else plain invite (no target)
  api -> db : BEGIN; INSERT new member row;\nmark invite used; revision +1
  activate db
  db --> api : COMMIT
  deactivate db
  api --> app : app-data envelope for new member
end

deactivate api
app --> child : профиль привязан, XP на месте
deactivate app
deactivate child
@enduml
