@startuml
title
FamTrack - вход, загрузка данных, durable команды и conflict handling
Дата: 2026-08-12
Источник: FamTrack@1e24e6a50f13
end title
footer Построено по текущему worktree, включая незакоммиченные изменения

skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam sequence {
  ArrowColor #475569
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F8FAFC
  ActorBorderColor #B45309
  ActorBackgroundColor #FEF3C7
}
autonumber

actor "Участник семьи" as User
participant "Telegram WebView" as WebView
participant "React Mini App" as Frontend
participant "ServerAdapter\napi.ts" as Adapter
database "IndexedDB outbox\noutbox.ts" as Outbox
participant "HTTP API\nserver/index.ts" as Api
participant "Auth\nserver/auth.ts" as Auth
participant "RBAC\nserver/rbac.ts" as Rbac
participant "FamTrackDatabase\nserver/database.ts" as Db
database "SQLite" as SQLite

group Загрузка приложения
  User -> WebView : Открывает Mini App
  WebView -> Frontend : initData + themeParams + safe area
  Frontend -> Adapter : loadData()
  Adapter -> Api : GET /api/app-data\nX-Telegram-Init-Data
  Api -> Auth : validateRequestAuth(initData)
  Auth -> Auth : HMAC Telegram initData\nи проверка max age
  Auth --> Api : AuthContext
  Api -> Db : resolveActor(auth)
  Db -> SQLite : SELECT active user\nby telegram_id/username
  SQLite --> Db : user row
  Api -> Db : exportEnvelope(actor)
  Db -> SQLite : SELECT family-scoped rows
  SQLite --> Db : AppData rows
  Api -> Rbac : filterForActor(data, actor)
  Rbac --> Api : visible AppData
  Api -> Api : applyCapabilities(data, capabilities)
  Api --> Adapter : 200 {revision, data}\nETag: family revision
  Adapter -> Adapter : latestRevision, latestData, latestEtag
  Adapter -> Adapter : scheduleOutboxReplay()
  Adapter --> Frontend : React Query cache update
end

group Повторная загрузка без изменений
  Adapter -> Api : GET /api/app-data\nIf-None-Match: latestEtag
  Api -> Db : getRevision(familyId)
  Db --> Api : та же revision
  Api --> Adapter : 304 без тела
  Adapter -> Adapter : отдать latestData\nи запустить outbox replay
end

group Успешная запись
  User -> Frontend : Изменяет задачу, рутину,\nфинансы или запасы
  Frontend -> Adapter : command(path, payload)
  Adapter -> Adapter : createMutationId()
  Adapter -> Outbox : put({mutationId, path,\nenvelope:{revision, ...payload}})
  note right of Outbox
    Запись переживает закрытие Mini App,
    перезагрузку WebView и офлайн.
    Бинарные страницы чека хранятся
    как Blob до подтверждения.
  end note
  Adapter -> Adapter : requestQueue.enqueue\n(single-flight по всему outbox)
  Adapter -> Api : POST /api/...\n{revision, mutationId, ...}\nX-FamTrack-Outbox-Retry
  Api -> Auth : validateRequestAuth()
  Auth --> Api : AuthContext
  Api -> Db : resolveActor()
  Db --> Api : свежий actor
  Api -> Rbac : assertCanWrite(actor, path, body, data)
  Rbac --> Api : allowed
  Api -> Db : mutateCommand(familyId, revision,\nreceipt, mutator, actor)
  Db -> SQLite : SELECT mutation_receipts\nпо (family_id, mutation_id)
  SQLite --> Db : нет квитанции
  Db -> SQLite : BEGIN IMMEDIATE
  Db -> Db : assertWriteSetCoversChanges\n(route-scoped write set)
  Db -> SQLite : replace только затронутые коллекции
  Db -> SQLite : UPDATE families.revision = revision + 1
  Db -> SQLite : INSERT mutation_receipts
  Db -> SQLite : COMMIT
  Db -> Db : persist: tmp + fsync + rename
  Db --> Api : {revision, data, command}
  Api -> Rbac : filterForActor(nextData, actor)
  Api --> Adapter : 200 {revision, data,\ncommand:{mutationId, duplicate:false, rebased}}\nETag: новая revision
  Adapter -> Adapter : сверить command.mutationId\nс отправленным
  Adapter -> Outbox : remove(mutationId)
  Adapter --> Frontend : SaveState SAVED\nи обновлённые данные
end

group Обрыв связи и повтор
  Adapter -> Api : POST /api/... (тот же mutationId)
  Api --> Adapter : сеть оборвалась, ответ не получен
  Adapter -> Outbox : attempts + 1, lastError
  Adapter --> Frontend : SaveState SAVING (pending > 0)
  ... соединение восстановлено ...
  Adapter -> Api : POST /api/... (тот же mutationId)
  Api -> Db : mutateCommand(...)
  Db -> SQLite : SELECT mutation_receipts
  SQLite --> Db : квитанция найдена
  Db -> Db : assertMatchingReceipt:\noperation и request_hash совпали
  Db --> Api : {revision, data,\ncommand:{duplicate:true}}
  Api --> Adapter : 200, запись не повторилась
  Adapter -> Outbox : remove(mutationId)
end

group Параллельная запись другого участника
  Adapter -> Api : POST /api/...\n{revision: устаревшая, mutationId}
  Api -> Db : mutateCommand(...)
  Db -> SQLite : SELECT current revision
  SQLite --> Db : revision ушла вперёд
  Db -> Db : expectedRevision < revision\n-> rebase поверх свежих данных
  Db --> Api : {revision, data,\ncommand:{rebased:true}}
  Api --> Adapter : 200 без конфликта
  note right of Db
    409 остаётся только для клиента,
    чья revision опережает серверную,
    то есть для рассинхронизированного состояния.
  end note
end

group Команда, требующая проверки
  Adapter -> Api : POST /api/...
  Api --> Adapter : 4xx (RBAC, валидация, feature disabled)
  Adapter -> Outbox : needsReview = true, lastError
  Adapter --> Frontend : SaveState ATTENTION
  User -> Frontend : Повторить вручную
  Frontend -> Adapter : retryOutbox()
  Adapter -> Outbox : сбросить attempts и needsReview
  Adapter -> Api : повторная доставка
end

group Auth failure
  Adapter -> Api : запрос без валидного initData
  Api -> Auth : validateRequestAuth()
  Auth --> Api : AuthError
  Api --> Adapter : 401
  Adapter --> Frontend : show error state
end

group Запись до загрузки
  Frontend -> Adapter : command(path, payload)
  Adapter --> Frontend : ApiError 428\n«Данные семьи ещё не загружены»
  note right of Adapter
    Команда без загруженной revision
    не попадает в outbox: сервер обязан
    получить осознанную базовую revision.
  end note
end

@enduml
